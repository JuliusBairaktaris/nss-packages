+			nim->msg.conn_stats_many.count = max;
+		}
+
 		/*
 		 * Update driver statistics on connection sync many.
 		 */
@@ -126,6 +143,7 @@ static void nss_ipv6_rx_msg_handler(stru
 		ncm->cb = (nss_ptr_t)nss_ipv6_conn_sync_many_msg_cb;
