 /*
+ * nss_codel_flow_count()
+ *	Number of flow queues this qdisc will run with.
+ *
+ * A zero flow count from tc means "use the default" on nssfq_codel and "single
+ * queue, no flow queue memory at all" on plain nsscodel. Which of the two this
+ * is decides that, never the value itself, so everything that depends on the
+ * count - whether to ask the firmware for a per-flow size, how much memory to
+ * allocate, and what to tell the firmware - resolves it here and agrees.
+ */
+static uint32_t nss_codel_flow_count(struct Qdisc *sch, struct tc_nsscodel_qopt *qopt)
+{
+	if (sch->ops != &nss_fq_codel_qdisc_ops) {
+		return 0;
+	}
+
+	return qopt->flows ? qopt->flows : NSS_CODEL_DEFAULT_FQ_COUNT;
+}
