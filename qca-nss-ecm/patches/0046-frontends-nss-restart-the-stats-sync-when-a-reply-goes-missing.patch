+
+			/*
+			 * The reply re-queues us at once. If it never comes, this
+			 * timeout is the only thing left that will.
+			 */
+			queue_delayed_work(ecm_nss_ipv4_workqueue, &ecm_nss_ipv4_work, ECM_NSS_IPV4_STATS_SYNC_TIMEOUT);
 			return;
 		}
+
+		spin_lock_bh(&ecm_nss_ipv4_lock);
+		ecm_nss_ipv4_sync_req_pending = false;
+		spin_unlock_bh(&ecm_nss_ipv4_lock);
 		ecm_nss_ipv4_stats_request_fail++;
