+	bool current_reply;
 	int i;
 
 	/*
@@ -651,20 +657,43 @@ static void ecm_nss_ipv4_connection_sync_many_callback(void *app_data, struct ns
 		return;
 	}
 
+	/*
+	 * The firmware returns the request's app_data in its reply, as the rule
+	 * create and destroy callbacks also rely on. A reply without the tag of
+	 * the request in flight answers one we have already given up on: its
+	 * records are still real deltas, but the chain has moved on without it.
+	 */
+	spin_lock_bh(&ecm_nss_ipv4_lock);
+	current_reply = ecm_nss_ipv4_sync_req_pending
+			&& ((unsigned long int)app_data == ecm_nss_ipv4_sync_req_seq);
