 EXPORT_SYMBOL(ecm_interface_get_and_hold_dev_master);
 
 /*
+ * ecm_interface_dsa_8021q_port()
+ *	The DSA port of a switch tagged with qca-8021q, or NULL.
+ */
+static struct dsa_port *ecm_interface_dsa_8021q_port(struct net_device *dev)
+{
+#ifdef DSA_TAG_PROTO_QCA_8021Q_VALUE
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev))
+		return NULL;
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR(dp) || dp->cpu_dp->tag_ops->proto != DSA_TAG_PROTO_QCA_8021Q)
+		return NULL;
+
+	return dp;
+#else
+	return NULL;
+#endif
+}
+
+/*
+ * ecm_interface_dsa_8021q_vid()
+ *	A port of a switch tagged with qca-8021q reaches its conduit as an
+ *	802.1Q VLAN, and the firmware can carry it as one: the port's own,
+ *	that of the VLAN-unaware bridge it forwards in, or in a VLAN-aware
+ *	bridge br_vid, the bridge VLAN of the flow (-1 when not known).
+ *	Returns the VID, or -1.
+ */
+static int ecm_interface_dsa_8021q_vid(struct net_device *dev, int br_vid)
+{
+	struct dsa_port *dp = ecm_interface_dsa_8021q_port(dev);
+	struct net_device *br;
+
+	if (!dp)
+		return -1;
+
+	br = dsa_port_bridge_dev_get(dp);
+	if (!br)
+		return dsa_tag_8021q_standalone_vid(dp);
+
+	if (br_vlan_enabled(br))
+		return br_vid;
+
+	return dsa_tag_8021q_bridge_vid(dsa_port_bridge_num_get(dp));
+}
+
+/*
+ * ecm_interface_bridge_vid()
+ *	The VLAN a flow sent to dev travels in on a VLAN-aware bridge: dev's
+ *	VID when dev is a VLAN on such a bridge, the bridge's PVID when dev is
+ *	the bridge itself. Returns -1 otherwise.
+ */
+static int ecm_interface_bridge_vid(struct net_device *dev)
+{
+	struct net_device *br = dev;
+	int vid = -1;
+	u16 pvid;
+
+	if (is_vlan_dev(dev))
+		br = vlan_dev_next_dev(dev);
+
+	if (!netif_is_bridge_master(br) || !br_vlan_enabled(br))
+		return -1;
+
+	if (br != dev)
+		return vlan_dev_vlan_id(dev);
+
+	rcu_read_lock();
+	if (!br_vlan_get_pvid_rcu(br, &pvid) && pvid) {
+		vid = pvid;
+	}
+	rcu_read_unlock();
+
+	return vid;
+}
+
+/*
  * ecm_interface_bridge_vlan_wire_tagged()
  *	Whether frames of a VLAN device stacked on a bridge appear tagged on
  *	the wire of the underlying bridge port in the given interface hierarchy.
@@ -811,9 +887,15 @@ int ecm_interface_bridge_vlan_wire_tagge
 	}
 
