  * ecm_interface_vlan_real_dev()
  *	Return immediate VLAN net device or Physical device pointer
  */
+/*
+ * ecm_interface_dsa_8021q_vid()
+ *	A port of a switch tagged with qca-8021q reaches its conduit as an
+ *	802.1Q VLAN, its own or that of the bridge it forwards in, and the
+ *	firmware can carry it as one. Returns the VID, or -1.
+ */
+static int ecm_interface_dsa_8021q_vid(struct net_device *dev)
+{
+#ifdef DSA_TAG_PROTO_QCA_8021Q_VALUE
+	struct net_device *br;
+	struct dsa_port *dp;
+
+	if (!dsa_user_dev_check(dev))
+		return -1;
+
+	dp = dsa_port_from_netdev(dev);
+	if (IS_ERR(dp) || dp->cpu_dp->tag_ops->proto != DSA_TAG_PROTO_QCA_8021Q)
+		return -1;
+
+	br = dsa_port_bridge_dev_get(dp);
+	if (!br)
+		return dsa_tag_8021q_standalone_vid(dp);
+
+	/*
+	 * A VLAN-aware bridge sends its own tags
+	 */
+	if (br_vlan_enabled(br))
+		return -1;
+
+	return dsa_tag_8021q_bridge_vid(dsa_port_bridge_num_get(dp));
+#else
+	return -1;
+#endif
+}
+
+/*
+ * ecm_interface_is_vlan()
+ *	A VLAN device, or a switch port that ECM carries as one.
+ */
+static inline bool ecm_interface_is_vlan(struct net_device *dev)
+{
+	return is_vlan_dev(dev) || ecm_interface_dsa_8021q_vid(dev) >= 0;
+}
+
 static inline struct net_device *ecm_interface_vlan_real_dev(struct net_device *vlan_dev)
 {
+	if (!is_vlan_dev(vlan_dev))
+		return dsa_port_from_netdev(vlan_dev)->cpu_dp->conduit;
+
 	return vlan_dev_next_dev(vlan_dev);
 }
 
