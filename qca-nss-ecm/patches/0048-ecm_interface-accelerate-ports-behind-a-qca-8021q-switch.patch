--- a/ecm_interface.h
+++ b/ecm_interface.h
@@ -7,11 +7,22 @@
  */
 
 #include <linux/if_arp.h>
+#include <linux/if_vlan.h>
 
 #ifdef ECM_INTERFACE_VXLAN_ENABLE
 #include <net/vxlan.h>
 #endif
 
+/*
+ * ecm_interface_vlan_egress_qos()
+ *	The priority bits of a VLAN device's egress map, none for a switch port
+ *	that ECM treats as a VLAN.
+ */
+static inline u16 ecm_interface_vlan_egress_qos(struct net_device *dev, u32 prio)
+{
+	return is_vlan_dev(dev) ? vlan_dev_get_egress_qos_mask(dev, prio) : 0;
+}
