-		DEBUG_WARN("%px: %s is not a VLAN device\n", vlan_ii, vlan_dev->name);
+		/*
+		 * A switch port carried as a VLAN has its tag on the conduit
+		 */
+		ret = ecm_interface_dsa_8021q_port(vlan_dev) ? 1 : -1;
+		if (ret < 0) {
+			DEBUG_WARN("%px: %s is not a VLAN device\n", vlan_ii, vlan_dev->name);
+		}
 		dev_put(vlan_dev);
-		return -1;
+		return ret;
 	}
 
 	real_dev = vlan_dev_real_dev(vlan_dev);
@@ -852,7 +934,12 @@ int ecm_interface_bridge_vlan_wire_tagge
 		return -1;
 	}
 
-	if (br_vlan_get_info_rcu(port_dev, vid, &vinfo)) {
+	if (ecm_interface_dsa_8021q_port(port_dev)) {
+		/*
+		 * A qca-8021q switch port carries the VLAN as its own tag
+		 */
+		ret = 0;
+	} else if (br_vlan_get_info_rcu(port_dev, vid, &vinfo)) {
 		/*
 		 * The port is not a member of this VLAN: misconfiguration or
 		 * a stale hierarchy - never accelerate on guesses.
@@ -916,11 +1003,23 @@ static inline bool ecm_interface_lookup_
 #endif
 
 /*
+ * ecm_interface_is_vlan()
+ *	A VLAN device, or a switch port that ECM carries as one.
+ */
+static inline bool ecm_interface_is_vlan(struct net_device *dev, int br_vid)
+{
+	return is_vlan_dev(dev) || ecm_interface_dsa_8021q_vid(dev, br_vid) >= 0;
+}
+
+/*
  * ecm_interface_vlan_real_dev()
  *	Return immediate VLAN net device or Physical device pointer
  */
 static inline struct net_device *ecm_interface_vlan_real_dev(struct net_device *vlan_dev)
 {
+	if (!is_vlan_dev(vlan_dev))
+		return dsa_port_from_netdev(vlan_dev)->cpu_dp->conduit;
+
 	return vlan_dev_next_dev(vlan_dev);
 }
 
